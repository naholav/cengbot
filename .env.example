# =============================================================================
# CengBot environment template
# =============================================================================
# Copy to the project root and fill in real values:
#     cp .env.example .env && chmod 600 .env
# - Variables already set in the process environment override .env.
# - Empty value = use the default. Relative paths resolve against the project root.
# - Never commit .env (it is gitignored).
# This root file is the single canonical template (config/env/ is gitignored;
# config/env/.env.example is a local copy kept in sync with it).

# =============================================================================
# TELEGRAM BOT
# =============================================================================
# Required. Token from @BotFather (format: 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: only answer messages in this forum topic (message_thread_id).
# Empty = all topics.
TELEGRAM_TOPIC_ID=

# Production bot (src/telegram_bot_rabbitmq.py): the ONE chat id it answers
# (a single id, not a list). Empty = -1002630398173 (the department group).
TELEGRAM_ALLOWED_CHAT_ID=

# Legacy/dev bots only (src/telegram_bot.py, src/telegram_bot_standalone.py):
# comma-separated chat-id allow-list. Empty = answer every chat (a warning is logged).
TELEGRAM_ALLOWED_CHAT_IDS=

# Seconds a user waits for the worker's answer before the fallback reply (default 30)
BOT_ANSWER_TIMEOUT=30

# =============================================================================
# DATABASE
# =============================================================================
# SQLite URL; a relative path resolves against the project root
DATABASE_URL=sqlite:///university_bot.db

# =============================================================================
# RABBITMQ
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Optional credentials. Empty = guest/guest (RabbitMQ accepts guest on localhost only).
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Queue names shared by the bot and the worker (defaults: questions / answers)
QUESTIONS_QUEUE=questions
ANSWERS_QUEUE=answers

# =============================================================================
# AI MODEL
# =============================================================================
# Active model directory. Empty = models/active-model, the symlink managed by
# scripts/switch_model.sh (see docs/MODEL_SWAP.md). Set it only to pin a
# specific model directory; it then wins over the symlink.
MODEL_PATH=

# LEGACY - ignored by the worker (a stale value used to silently load the old
# v1 model). Do not set; use MODEL_PATH or scripts/switch_model.sh instead.
# LORA_MODEL_PATH=

# Base model, used when the adapter's adapter_config.json does not name one
BASE_MODEL_NAME=meta-llama/Llama-3.2-3B

# Hugging Face token for the gated LLaMA base model. Only needed to download
# it into model_cache/ (first setup) or for training; inference runs offline.
HUGGING_FACE_TOKEN=

# Model loading is offline-first (cached weights in MODEL_CACHE_DIR are used
# with local_files_only). Downloads of missing weights are allowed by default
# (MODEL_ALLOW_DOWNLOAD=true); either of these blocks them completely:
# HF_HUB_OFFLINE=1          (TRANSFORMERS_OFFLINE=1 works too)
# MODEL_ALLOW_DOWNLOAD=false
# HF_TOKEN / HUGGINGFACE_HUB_TOKEN are accepted as aliases of HUGGING_FACE_TOKEN
MODEL_CACHE_DIR=model_cache

# Generation settings (read by src/llama_model_handler.py when the model loads)
MODEL_TEMPERATURE=0.7
MODEL_MAX_NEW_TOKENS=200
MODEL_TOP_P=0.95
MODEL_TOP_K=50
MODEL_REPETITION_PENALTY=1.1
# bfloat16 | float16 | float32
MODEL_PRECISION=bfloat16
USE_CUDA=true
# Prompt tokens kept (default 512, the LoRA training max_length)
# MODEL_MAX_INPUT_TOKENS=512
# Answers are cut to this many sentences (default 4, 0 = unlimited)
# MODEL_MAX_SENTENCES=4
# Prompt template: training (default, the template the adapter was trained
# with) or legacy (the old long system prompts)
# MODEL_PROMPT_STYLE=training
# Merge the LoRA adapter into the base weights at load time (default true,
# ~15 -> 33 tokens/s); false keeps the PEFT wrapper
# MODEL_MERGE_LORA=true

# AI worker (src/ai_model_worker.py), optional. Model-load and RabbitMQ
# failures back off exponentially (5 s -> 300 s); a question that keeps failing
# ("poison message") is answered with an apology after WORKER_MAX_ATTEMPTS.
# WORKER_MAX_ATTEMPTS=3            # deliveries per question before it is given up
# WORKER_RETRY_DELAY=2             # seconds before a failed question is retried
# WORKER_BACKOFF_INITIAL=5         # first retry delay (seconds) ...
# WORKER_BACKOFF_MAX=300           # ... doubled up to this cap
# WORKER_HEALTHY_AFTER=60          # a connection that lived this long resets the backoff
# WORKER_HEARTBEAT_PUMP_INTERVAL=1  # seconds between RabbitMQ heartbeat pumps during generation
# RABBITMQ_HEARTBEAT=60            # AMQP heartbeat (seconds)
# RABBITMQ_BLOCKED_TIMEOUT=300     # give up when the broker blocks publishing (e.g. disk full)

# Jailbreak / prompt-injection guard (src/prompt_guard.py), applied in the
# worker before generation: blocked prompts never reach the model and get a
# polite refusal (default true)
PROMPT_GUARD_ENABLED=true
# Longer questions get a polite refusal (default 1000 characters)
PROMPT_GUARD_MAX_CHARS=1000

# =============================================================================
# ADMIN API (src/admin_rest_api.py) / ADMIN PANEL
# =============================================================================
# 127.0.0.1 keeps the API local (the panel calls http://localhost:8001).
# Use 0.0.0.0 only behind a firewall / reverse proxy. Code default: 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8001
API_RELOAD=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_USERNAME=admin
# Admin password: set ONE of the two below. There is NO default password -
# if neither is set, every login is rejected (401) and an ERROR is logged.
# Preferred: SHA-256 hex digest (64 hex chars) of the password, e.g.
#   python3 -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
ADMIN_PASSWORD_HASH=
# Alternative: plain password (used only when ADMIN_PASSWORD_HASH is empty or invalid)
ADMIN_PASSWORD=
# Use an ASCII-only password: FastAPI's HTTP Basic auth decodes credentials as
# ASCII, so a password with non-ASCII characters (ç, ğ, ş, ...) can never log in.

# CORS_ORIGINS must contain the origin the admin panel is served from
# (scheme://host:port, e.g. https://admin.example.edu), or the browser blocks it.

# Frontend settings are baked into the bundle at BUILD time by `npm start` /
# `npm run build` (read from the shell or admin_frontend/.env.local, NOT from
# this file); rebuild the frontend after changing them:
#   REACT_APP_API_URL=http://localhost:8001
#   REACT_APP_ADMIN_USERNAME=admin

# =============================================================================
# LOGGING
# =============================================================================
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs
# logs/error.log is size-rotated (src/error_handler.py). Optional overrides:
# ERROR_LOG_FILE=logs/error.log
# ERROR_LOG_MAX_BYTES=10485760
# ERROR_LOG_BACKUP_COUNT=5
# Identical errors within this many seconds are logged as one line (default 300)
# ERROR_DEDUP_WINDOW=300

# =============================================================================
# SYSTEM MONITOR (src/system_monitor.py)
# =============================================================================
# Alert when a single file in logs/ is bigger than this (MB, default 500)
MONITOR_LOG_SIZE_THRESHOLD_MB=500
# Alert when logs/ as a whole is bigger than this (GB, default 5)
MONITOR_LOGS_TOTAL_THRESHOLD_GB=5
# Alert when free disk space drops below this (GB, default 2)
MONITOR_MIN_FREE_DISK_GB=2

# =============================================================================
# TRAINING / DATA AUGMENTATION
# =============================================================================
# src/train_model.py: dataset file(s), comma separated (the --dataset flag wins).
# Default: data/merged_qa_data.jsonl + data/cengbot_qa_augmented.jsonl
# TRAINING_DATASET=data/merged_qa_data.jsonl,data/cengbot_qa_augmented.jsonl
# Force the training-history version number (logs/training_history/v<N>.log)
# TRAINING_VERSION=

# src/data_augmentation.py (Claude API). Either key variable works; if neither
# is set the script asks for the key (it is never stored or printed).
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
# Model id (default claude-sonnet-5-5; --model wins)
# CLAUDE_MODEL=claude-sonnet-5-5
# Max output tokens per request (default 16000)
# CLAUDE_MAX_TOKENS=16000
# Optional pacing: minimum seconds between API requests (default 0)
# CLAUDE_REQUEST_INTERVAL=0
# Server-side refusal fallback for models that support it (on/off, default on)
# CLAUDE_REFUSAL_FALLBACK=on
# Only sent when set (current models reject non-default sampling parameters)
# CLAUDE_TEMPERATURE=
# Optional thinking effort, sent as output_config.effort to cut cost:
# low | medium | high | xhigh | max (unset = API default). Deliberately not
# named CLAUDE_EFFORT (some developer tools export that name into their shells).
# AUGMENT_CLAUDE_EFFORT=

# =============================================================================
# ADVANCED
# =============================================================================
# Alternative .env location (process environment only, e.g. in a systemd unit):
# CENGBOT_ENV_FILE=/etc/cengbot/cengbot.env

# Shell scripts (scripts/*.sh) - process environment only, normally unset:
# CENGBOT_ROOT=/path/to/project        run the scripts against another checkout
# CENGBOT_PYTHON=/path/to/python       interpreter (default: <root>/.venv/bin/python)
# CENGBOT_NO_RESTART=1                 switch_model.sh: never restart the AI worker
# CENGBOT_LOG_MAX_BYTES=52428800       start-time rotation threshold (50 MiB)
# CENGBOT_LOG_KEEP_BYTES=10485760      bytes of the tail kept in <log>.1.gz (10 MiB)
# CENGBOT_LOG_GENERATIONS=5            rotated generations kept
# CENGBOT_LOG_PRETRIM_BYTES=1073741824 rotate_logs.sh: tail-trim logs above 1 GiB before logrotate
# KEEP_BACKUPS=5 / KEEP_EXPORTS=10    backup_data.sh / export_database.sh: archives kept
# LOG_TAIL_BYTES=10485760              backup_data.sh: bytes of each big log included in a backup
# PANEL_API_URL=/api                   deploy_production.sh: API URL baked into the panel build
